{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": { 
    "separator": "",
    "color": { "keys": "#89b4fa" }
  },
  "modules": [
    {
      "type": "title",
      "key": "   ",
      "keyColor": "#b4befe",
      "color": {
        "user": "#b4befe",
        "at": "#7f849c",
        "host": "#89b4fa"
      }
    },
    { "type": "os", "key": "   ", "keyColor": "#89b4fa" },
    { "type": "kernel", "key": "   ", "keyColor": "#fab387" },
    { "type": "shell", "key": "   ", "keyColor": "#a6e3a1" },
    { "type": "packages", "key": "  󰏖 ", "keyColor": "#f9e2af" },
    { "type": "cpu", "key": "   ", "keyColor": "#94e2d5" },
    { "type": "gpu", "key": "  󰍛 ", "keyColor": "#f5c2e7" },
    { "type": "memory", "key": "  󰾲 ", "keyColor": "#a6e3a1" },
    { "type": "swap", "key": "   ", "keyColor": "#89dceb" },
    {
      "type": "disk",
      "key": "   ",
      "keyColor": "#f38ba8",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true
    },
    { "type": "colors", "symbol": "circle" }
  ]
}
