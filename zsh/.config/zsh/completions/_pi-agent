#compdef pi-agent

# Zsh completion for pi-agent — completes agent names from ~/agents/ or ~/Agents/
# with descriptions extracted from AGENTS.md first lines.

_pi-agent() {
  local -a agents
  local agents_dir

  # Check both lowercase and uppercase agent directories
  if [[ -d "$HOME/agents" ]]; then
    agents_dir="$HOME/agents"
  elif [[ -d "$HOME/Agents" ]]; then
    agents_dir="$HOME/Agents"
  fi

  [[ -n "$agents_dir" ]] || { _describe 'agent' agents; return }

  # Build agent list
  for dir in "$agents_dir"/*(N/); do
    local name="${dir:t}"
    local desc=""

    # Try to grab the first meaningful line from AGENTS.md for a description
    if [[ -f "$dir/AGENTS.md" ]]; then
      desc=$(head -5 "$dir/AGENTS.md" \
        | grep -v '^#' \
        | grep -v '^$' \
        | sed -n '1{p;q}' 2>/dev/null)
    fi

    agents+=("$name:${desc:-Agent profile}")
  done

  _describe 'agent' agents
}

_pi-agent "$@"
