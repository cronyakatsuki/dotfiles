# OS and editor artifacts
.DS_Store
*~
*.swp
*.swo

# ---- Editor/tool backups (safe-edit extension) ----
# safe-edit-backup drops timestamped backups next to edited files (e.g. .backups/)
# in every config dir; never sync those.
**/.backups/

# API keys and secrets
.config/secrets.env

# Local state (not synced)
zsh/**/.zcompdump
zsh/**/.zcompdump-*
zsh/**/.zsh_history
zsh/**/.zcompcache/

# Yazi external plugins (installed via `ya pkg install`, pinned in package.toml).
# Only user's own folder-rules.yazi is committed.
yazi/.config/yazi/plugins/*
!yazi/.config/yazi/plugins/folder-rules.yazi

# Tmux TPM plugins (installed via prefix+I, declared in tmux.conf)
tmux/.config/tmux/plugins/

# Vesktop vencord quick-css scratch file (empty unless user edits it in vencord UI)
vesktop/.config/vesktop/settings/quickCss.css

# Vesktop runtime state (electron app writes these into the stowed config dir while running)
vesktop/.config/vesktop/Code Cache/
vesktop/.config/vesktop/Crashpad/
vesktop/.config/vesktop/SingletonCookie
vesktop/.config/vesktop/SingletonLock
vesktop/.config/vesktop/SingletonSocket
vesktop/.config/vesktop/sessionData/
vesktop/.config/vesktop/state.json

# Pacman package lists (generated by `just packages-save`, tracked in system/)
system/*.tmp
/atuin/
