# OS and editor artifacts
.DS_Store
*~
*.swp
*.swo

# ---- Editor/tool backups (safe-edit extension) ----
# safe-edit-backup drops timestamped backups next to edited files (e.g. .backups/)
# in every config dir; never sync those.
**/.backups/

# API keys and secrets
.config/secrets.env

# Local state (not synced)
zsh/**/.zcompdump
zsh/**/.zcompdump-*
zsh/**/.zsh_history
zsh/**/.zcompcache/
/atuin/
